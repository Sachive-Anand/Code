                stack.push(val);
            }
            else if(command.equals("pop")){
                System.out.println(stack.pop());
            }else if(command.equals("top")){
                System.out.println(stack.top());
            }
            else if(command.equals("isEmpty")){
                System.out.println(stack.isEmpty());
            }
        }
