    class myStack{
        Queue<Long> queue=new LinkedList<>();
        
        void push(long val){
            queue.offer(val);
            
            int n=queue.size();
            for(int i=0;i<n-1;i++){
                queue.offer(queue.poll());
            }
        }
        long pop(){
           if(queue.isEmpty()){
               return -1L;
           } 
           return queue.poll();
        }
        long top(){
            if(queue.isEmpty()){
               return -1L;
           } 
           return queue.peek();
        }
        boolean isEmpty(){
            return queue.isEmpty();
        }
    }
    
